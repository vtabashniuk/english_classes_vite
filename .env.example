# PUBLIC browser configuration only. Never put SUPABASE_SERVICE_ROLE_KEY here.
# For local Supabase, retrieve the current local API URL and anon key via `npx supabase status`.
# For cloud, use that project's public URL and anon/publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY

# Origin where the frontend is served. Used for password recovery redirects.
# Match the actual Vite origin (or Vercel production URL), WITHOUT a trailing slash.
VITE_APP_URL=http://127.0.0.1:3000

# Gate 4.4-A: Google entry UI remains OFF unless set to true locally.
# Do not enable in Production until Gate 4.5/4.6 controls are completed.
VITE_GOOGLE_OAUTH_ENABLED=false

# Local Supabase Google provider only. Supabase CLI reads these from the root .env
# through env() in supabase/config.toml. Do NOT add VITE_ to these names.
# Keep credentials out of Git; use your own local Google Cloud OAuth Web Client.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_LOCAL_GOOGLE_CLIENT_ID
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_LOCAL_GOOGLE_CLIENT_SECRET

# Local Edge Functions read supabase/functions/.env, not this root file:
# APP_URL=http://127.0.0.1:3000 (put it in supabase/functions/.env)
